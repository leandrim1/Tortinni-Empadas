# ─────────────────────────────────────────────────────────────
# Tortinni Empadas — variáveis de ambiente
# Copie para .env (local) ou cadastre na Vercel (produção).
# NENHUM destes valores pode ir para o código do navegador.
# ─────────────────────────────────────────────────────────────

# Banco de dados Neon PostgreSQL.
# Use o endpoint "pooled" (-pooler) em produção serverless.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-123456-pooler.sa-east-1.aws.neon.tech/tortinni?sslmode=require"

# Segredo das sessões e dos tokens CSRF. Mínimo de 32 caracteres.
# Gere com: openssl rand -base64 48
SESSION_SECRET="troque-este-valor-por-uma-string-aleatoria-de-48-caracteres"

# URL pública do site. Usada em links de e-mail, CORS e no link de acompanhamento.
PUBLIC_SITE_URL="http://localhost:5173"

# Origens extras permitidas no CORS, separadas por vírgula (opcional).
ALLOWED_ORIGINS="https://tortinni.vercel.app"

# ── Vercel Blob (imagens de produtos, banners e identidade visual) ──
# Painel da Vercel → Storage → Blob → "Connect". Token SOMENTE no servidor.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXXXXXXXXXX_xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Criação do primeiro administrador via API (opcional) ──
# Token de uso único para POST /api/admin/bootstrap.
# Alternativa recomendada: `npm run admin:create` no servidor.
ADMIN_BOOTSTRAP_TOKEN="gere-um-token-aleatorio-e-apague-depois-do-uso"

# ── E-mail (verificação de conta e recuperação de senha) ──
# Sem estas variáveis o sistema continua funcionando, mas informa ao cliente
# que a recuperação por e-mail ainda não está disponível.
EMAIL_PROVIDER="console"            # "resend" para ativar o envio real
RESEND_API_KEY=""
EMAIL_FROM="Tortinni Empadas <pedidos@seudominio.com.br>"

# ── Pagamento online (Pix) ──
# Enquanto não forem preenchidas, o Pix automático fica marcado como
# "pendente de configuração" e só os meios realmente habilitados aparecem.
PAYMENT_PROVIDER=""                 # "validapay" para ativar
PAYMENT_API_BASE_URL="https://sandbox.validapay.com.br"
PAYMENT_CLIENT_ID=""
PAYMENT_CLIENT_SECRET=""
PAYMENT_WEBHOOK_SECRET=""           # segredo do webhook (assinatura X-Webhook-Signature)

# ── Ajustes finos (opcionais) ──
DATABASE_POOL_MAX="3"
API_PORT="3001"
